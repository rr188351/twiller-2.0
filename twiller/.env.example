# ---------------------------------------------------------------------------
# Twiller 2.0 frontend - example environment file
# Copy this file to ".env.local" and fill in your real values.
# NOTE: the backend .env is loaded on the SERVER only. It is never exposed
# to the browser, which is why no database or mail secrets belong in here.
# ---------------------------------------------------------------------------

# Base URL of the Express backend that the frontend calls through axios.
# Use http://localhost:5000 for local development.
# Use the deployed backend URL (e.g. https://twiller-backend.onrender.com)
# after deploying the backend.
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Firebase Authentication (Twiller's existing login system)
# Get these from: Firebase console -> Project settings -> Your apps
#                -> SDK setup and configuration -> Config
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
