# ---------------------------------------------------------------------------
# Twiller 2.0 backend - example environment file
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file (it is git-ignored).
# ---------------------------------------------------------------------------

# --- Server ---
PORT=5000

# --- Database ---
# NOTE: the variable name below is intentionally "MONOGDB_URL" because the
# existing backend code (backend/index.js) reads process.env.MONOGDB_URL.
# "MONGODB_URL" (correct spelling) is also accepted as a fallback.
MONOGDB_URL=mongodb://127.0.0.1:27017/twiller

# --- Internship feature providers -----------------------------------------
# "mock"    = no external account needed, values are logged to the server
#             console (development/demo only)
# "smtp"    = real email through an SMTP server (nodemailer)
# "live"    = real payment gateway
#
# OTP delivery is EMAIL ONLY. Every locale (fr, en, hi, es, pt, zh) receives its
# one-time code by email; the mobile/SMS channel has been removed from the
# product, so there is no SMS_* configuration any more.
# Set NODE_ENV=production to guarantee that dev codes are never returned
# by the API, regardless of these values.
PAYMENT_MODE=mock
# Production REQUIRES a real email provider. With NODE_ENV=production, leaving
# OTP_DELIVERY as "console" (or unset) makes every OTP fail safely with
# 502 delivery-failed instead of pretending a mock email was sent. Set
# OTP_DELIVERY=smtp plus SMTP_HOST/SMTP_PORT/SMTP_SECURE/SMTP_USER/SMTP_PASS/
# MAIL_FROM (below) to deliver real email.
OTP_DELIVERY=console
NODE_ENV=development

# --- Feature 5: Audio Tweets -----------------------------------------------
# FFPROBE_PATH environment variable to locate ffprobe executable.
# If ffprobe is on PATH, you don't need to set this.
# If ffprobe is not on PATH, set FFPROBE_PATH to the absolute path of
# the ffprobe executable (e.g., C:\tools\ffmpeg\bin\ffprobe.exe).
# This is critical for audio duration validation in production.
# The application will fall back to searching PATH automatically.
# Example: FFPROBE_PATH=/usr/local/bin/ffprobe
# Example: FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
FFPROBE_PATH=

# --- Upload storage (Features 4 & 5) ---------------------------------------
# Directories must PERSIST across deploys. On most Node hosts this means an
# attached persistent disk/volume (e.g. Render Disk) or object storage; the
# container filesystem is ephemeral by default.
#   AUDIO_UPLOAD_DIR  where audio tweets are written (default: uploads/)
#   IMAGE_UPLOAD_DIR  where uploaded images are written (default: uploads/images/)
# Both are also served read-only at /uploads and /uploads/images.
AUDIO_UPLOAD_DIR=uploads/
IMAGE_UPLOAD_DIR=uploads/images/

# --- CORS ------------------------------------------------------------------
# Leave EMPTY for local development (permissive). In production set this to a
# comma-separated allow-list of the real frontend origin(s), e.g.
#   CORS_ORIGINS=https://your-site.netlify.app,https://your-domain.com
CORS_ORIGINS=

# --- Feature 6: Forgot Password limits ------------------------------------
# OTP_TTL_MINUTES        how long an emailed OTP stays valid
# RECOVERY_TOKEN_MINUTES how long the verified recovery session stays valid
# RATE_LIMIT_MAX         max recovery requests per IP inside the window
# RATE_LIMIT_WINDOW_MS   length of that window in milliseconds
OTP_TTL_MINUTES=10
RECOVERY_TOKEN_MINUTES=15
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=900000


# --- RECOMMENDED ON HOSTS THAT BLOCK SMTP (e.g. Render Free): Brevo HTTPS API --
# Some hosts block outbound SMTP (Render Free blocks ports 25/465/587), so the
# Language/Audio OTP emails can never be sent from there over SMTP. Brevo's REST
# API runs on HTTPS/443 (never blocked) and its FREE plan covers 300 emails/day.
# NO DOMAIN IS NEEDED: add your FROM address as a sender in Brevo, then enter the
# 6-digit code Brevo emails to that address to activate it.
#   BREVO_API_KEY=<Brevo: Settings -> SMTP & API -> API keys>   NEVER commit this
#   MAIL_FROM   must be the sender you VERIFIED in Brevo
#   MAIL_PROVIDER=brevo   (optional - inferred when BREVO_API_KEY is present)
#   optional: BREVO_TIMEOUT_MS=15000, BREVO_API_URL (tests only)
BREVO_API_KEY=

# --- Real email (used when OTP_DELIVERY=smtp) --------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Twiller <no-reply@twiller.local>"

# Bounded-failure timeouts (milliseconds). Without these, nodemailer's own
# default connect timeout is 120s, and an SMTP egress that is BLACKHOLED (e.g.
# Render's Free plan blocks ports 25/465/587) would leave the OTP request in
# "pending" for ~2 minutes. Defaults shown; only raise them for an unusually
# slow mail server.
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# --- SMS / mobile OTP: REMOVED ------------------------------------------------
# Twiller no longer sends one-time codes by SMS. backend/utils/sms.js and every
# SMS_* variable (SMS_DELIVERY, SMS_ACCOUNT_SID, SMS_AUTH_TOKEN, SMS_FROM,
# SMS_DEFAULT_COUNTRY_CODE, SMS_PROVIDER) have been removed from the codebase.
# Every locale uses the email provider configured above.

# --- Feature 4 (phase 2): Firebase-authenticated language-switch OTP --------
# The /auth/language/otp/* endpoints verify `Authorization: Bearer <Firebase
# ID token>` with the Firebase Admin SDK. Identity (UID + email) comes ONLY
# from the verified token - never from client-supplied email/phone/user ids.
#
# HOW TO CONFIGURE (no real values belong in this file or in git):
#   Firebase console -> Project settings -> Service accounts ->
#   "Generate new private key". Then EITHER:
#   (a) paste the whole JSON on ONE line as FIREBASE_SERVICE_ACCOUNT_JSON in
#       your local git-ignored backend/.env (preferred for local dev), OR
#   (b) save the JSON OUTSIDE the repo (e.g. C:\secrets\twiller-firebase.json)
#       and set FIREBASE_SERVICE_ACCOUNT_PATH (or GOOGLE_APPLICATION_CREDENTIALS)
#       to its absolute path.
# Without one of these, the language OTP endpoints answer 503 auth-unavailable
# (fail closed). Never commit a service-account file inside the repository.
FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\secrets\twiller-firebase.json
#
# OTP tuning (defaults shown; same semantics as the Feature 6 knobs above):
# LANGUAGE_OTP_TTL_MINUTES            how long a language code stays valid
# LANGUAGE_OTP_MAX_ATTEMPTS           wrong-code attempts before the code dies
# LANGUAGE_OTP_RESEND_COOLDOWN_SECONDS minimum wait between code sends
LANGUAGE_OTP_TTL_MINUTES=10
LANGUAGE_OTP_MAX_ATTEMPTS=5
LANGUAGE_OTP_RESEND_COOLDOWN_SECONDS=60
